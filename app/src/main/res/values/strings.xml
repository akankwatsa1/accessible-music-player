    <!-- Help -->
    <string name="help_title">Help and gestures</string>
    <string name="help_body">Tap a track to play it. Use the buttons at the bottom to play or pause, move between tracks, and jump back or forward 10 seconds. Drag the position slider to seek. Tap the chevron at the top right to hide or show the extra controls so only search and the library remain. Use the star on a track to add it to favourites. All controls are labelled for TalkBack.</string>
    <string name="about_title">About</string>
    <string name="about_body">Accessible Music Player %1$s\n\nA lightweight TalkBack-first player for the music and video already on your device. Nothing is uploaded and no account is needed.</string>

